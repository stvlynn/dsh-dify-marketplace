{
  "name": "dsh-dify-marketplace",
  "version": "0.1.0",
  "description": "Browse, search, and install Dify Marketplace plugins from inside DeepSeek Harness, and register each installed Dify plugin as a standard DSH plugin.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvlynn/dsh-dify-marketplace.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "dify",
    "marketplace",
    "plugin-manager"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "deploy",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host",
    "build:client": "tsc -p tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client && node scripts/normalize-client-banner.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration/marketplace",
    "test:integration:daemon": "vitest run --config vitest.integration.config.ts tests/integration/daemon",
    "test:e2e": "playwright test --project=marketplace",
    "test:e2e:dsh": "playwright test --project=dsh",
    "capture:marketplace": "node scripts/capture-marketplace.mjs",
    "package:fixture": "bash scripts/package-fixture.sh",
    "daemon:up": "docker compose -f deploy/plugin-daemon/docker-compose.yml up -d --wait",
    "daemon:down": "docker compose -f deploy/plugin-daemon/docker-compose.yml down -v",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
